<Window x:Class="Qlyptra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qlyptra" Width="900" Height="580" MinWidth="900" MinHeight="580"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False" Background="{DynamicResource WindowBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="True" Topmost="False" Loaded="Window_Loaded" SourceInitialized="Window_SourceInitialized" Closed="Window_Closed">
    <Border x:Name="RootBorder" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="1" SnapsToDevicePixels="True">
        <Grid Margin="1" ClipToBounds="True">
            <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border x:Name="TopChrome" Grid.Row="0" Panel.ZIndex="200" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid Margin="16,0,16,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                    <Border x:Name="ArtworkBorder" Width="32" Height="32" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="ArtworkFallback" Text="Q" Foreground="White" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                            <Image x:Name="AppArtworkImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                            <Rectangle IsHitTestVisible="False" Opacity="0.16" Fill="{DynamicResource AccentBrush}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{Binding Source, ElementName=AppArtworkImage}" Stretch="UniformToFill"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Qlyptra" FontSize="14" FontWeight="SemiBold" Foreground="#F5F5F7"/>
                        <TextBlock Text="MUSIC CLIPBOARD" FontSize="8.5" Foreground="#81828D" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="—" Click="Hide_Click" ToolTip="Скрыть в трей" Style="{StaticResource CaptionButtonStyle}" Width="36" Height="36" Margin="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="3" Content="×" Click="Close_Click" ToolTip="Закрыть приложение" Style="{StaticResource CaptionCloseButtonStyle}" Width="36" Height="36" Margin="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="SideChrome" Grid.Column="0" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="0,0,1,0">
                    <Grid Margin="12,18,12,14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" FontSize="10" Foreground="#747681" Margin="10,0,0,12"/>
                        <StackPanel Grid.Row="1">
                            <Button x:Name="ConverterNav" Tag="Active" Style="{StaticResource NavButtonStyle}" Click="ConverterNav_Click" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="♫" FontSize="19" Width="28" VerticalAlignment="Center"/><TextBlock Text="Трек и ссылка" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button x:Name="SettingsNav" Tag="Inactive" Style="{StaticResource NavButtonStyle}" Click="SettingsNav_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="16" Width="28" VerticalAlignment="Center"/><TextBlock Text="Настройки" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Margin="8,0,8,0">
                            <Border Height="1" Background="{DynamicResource BorderBrushCustom}" Margin="0,0,0,12"/>
                            <TextBlock Text="Qlyptra · 1.0.0" Foreground="#737580" FontSize="11.5"/>
                            <TextBlock Margin="0,6,0,0" FontSize="11.5">
                                <Run Text="made by " Foreground="#737580"/>
                                <Hyperlink NavigateUri="https://t.me/wz3k9l" RequestNavigate="AuthorLink_RequestNavigate" Foreground="{DynamicResource AccentBrush}" TextDecorations="None">
                                    <Run Text="wz3k9l"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Column="1" Margin="22,18,22,16">
                    <Grid x:Name="ConverterView" Opacity="1" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="4"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Подготовить аудио" Foreground="#F3F3F6" FontWeight="SemiBold" FontSize="20"/>
                            <TextBlock Text="Вставьте ссылку на трек в Яндекс Музыке — программа скачает его и подготовит MP3" Foreground="#9697A1" FontSize="12.5" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,20,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="UrlTextBox" Style="{StaticResource DarkTextBoxStyle}" Height="42" ToolTip="Ссылка на трек Яндекс Музыки или прямой URL MP3" Text=""/>
                            <Button x:Name="DownloadButton" Grid.Column="1" Content="Найти / скачать" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Padding="6,4" FontSize="12.5" Click="ReadLink_Click"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Border Width="142" Height="142" Background="{DynamicResource CoverBrush}" BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="1" HorizontalAlignment="Left" ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                                        <StackPanel x:Name="CoverPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="♫" FontSize="44" Foreground="#666873" HorizontalAlignment="Center"/>
                                            <TextBlock Text="ОБЛОЖКА" FontSize="8.5" Foreground="#777984" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="SourceFileLabel" Text="Ожидание ссылки на трек" Foreground="#858691" FontSize="11.5" TextWrapping="Wrap" Margin="2,12,5,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Text="НАЗВАНИЕ ТРЕКА" Foreground="#898A95" FontSize="10.5" Margin="0,0,0,6"/>
                                <TextBox x:Name="TitleTextBox" Style="{StaticResource ReadOnlyInfoTextBoxStyle}" Height="40" IsReadOnly="True" IsTabStop="False" Focusable="False" Cursor="Arrow"/>
                                <TextBlock Text="ИСПОЛНИТЕЛИ" Foreground="#898A95" FontSize="10.5" Margin="0,14,0,6"/>
                                <TextBox x:Name="ArtistTextBox" Style="{StaticResource ReadOnlyInfoTextBoxStyle}" Height="40" IsReadOnly="True" IsTabStop="False" Focusable="False" Cursor="Arrow"/>
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="1" Padding="12,11" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="ReadyHintTitle" Text="ГОТОВНОСТЬ К ОТПРАВКЕ" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="10.5"/>
                                        <TextBlock Text="После загрузки появится окно: можно скопировать MP3 в буфер и вставить в любой мессенджер, сохранить трек на диск или скопировать ссылку." Foreground="#A6A7B0" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="DownloadProgressBar" Grid.Row="3" Visibility="Collapsed" ClipToBounds="True" Background="{DynamicResource HoverBrush}" SizeChanged="DownloadProgressBar_SizeChanged">
                            <Border x:Name="DownloadProgressFill" Width="90" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}">
                                <Border.RenderTransform><TranslateTransform x:Name="DownloadProgressTransform" X="-100"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <Border Grid.Row="4" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="1" Padding="12,10" Margin="0,10,0,0">
                            <DockPanel LastChildFill="True">
                                <Border x:Name="StatusDot" Width="7" Height="7" Background="#7B7C86" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="StatusText" Text="Вставьте ссылку на трек и нажмите «Найти / скачать»." Foreground="#A6A7B0" FontSize="12" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="SettingsView" Visibility="Collapsed" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Настройки" Foreground="#F3F3F6" FontWeight="SemiBold" FontSize="20"/>
                            <TextBlock Text="Внешний вид и поведение приложения" Foreground="#9697A1" FontSize="12.5" Margin="0,7,0,0"/>
                        </StackPanel>
                        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" CanContentScroll="False" IsDeferredScrollingEnabled="False" PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Width" Value="5"/>
                                    <Setter Property="MinWidth" Value="5"/>
                                    <Setter Property="MaxWidth" Value="5"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template"><Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Grid Width="5" Background="Transparent" HorizontalAlignment="Right">
                                                <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True">
                                                    <Track.Thumb>
                                                        <Thumb>
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Background="{DynamicResource BorderBrushCustom}" Width="5" MinHeight="24" CornerRadius="0"/>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value></Setter>
                                </Style>
                            </ScrollViewer.Resources>
                            <StackPanel Margin="0,0,8,6">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="1" Padding="14,13" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Тема приложения" Foreground="#F0F0F3" FontSize="13"/>
                                        <TextBlock Text="Системная, тёмная или светлая" Foreground="#90919B" FontSize="11.5" Margin="0,5,12,9"/>
                                        <ComboBox x:Name="ThemeCombo" Style="{StaticResource AppComboBoxStyle}" Height="36" SelectedValuePath="Tag" SelectionChanged="ThemeCombo_Changed">
                                            <ComboBoxItem Style="{StaticResource AppComboBoxItemStyle}" Content="Системная" Tag="System"/>
                                            <ComboBoxItem Style="{StaticResource AppComboBoxItemStyle}" Content="Тёмная" Tag="Dark"/>
                                            <ComboBoxItem Style="{StaticResource AppComboBoxItemStyle}" Content="Светлая" Tag="Light"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
<Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="1" Padding="14,13" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Яркость фона" Foreground="#F0F0F3" FontSize="13"/>
                                        <TextBlock Text="Делает фон приложения темнее или светлее в пределах выбранной темы" Foreground="#90919B" FontSize="11.5" Margin="0,5,12,9"/>
                                        <Slider x:Name="BrightnessSlider" Style="{StaticResource AppSliderStyle}" Minimum="0.25" Maximum="1.0" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="False" ValueChanged="BrightnessSlider_ValueChanged"/>
                                        <TextBlock x:Name="BrightnessValueLabel" Text="100%" Foreground="#90919B" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="1" Padding="14,13" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Токен Яндекс Музыки" Foreground="#F0F0F3" FontSize="13"/>
                                        <TextBlock Text="Нужен загрузчику для получения трека по ссылке. Токен шифруется Windows для текущей учётной записи и никуда не передаётся." Foreground="#90919B" FontSize="11.5" TextWrapping="Wrap" Margin="0,5,0,9"/>
                                        <PasswordBox x:Name="YandexTokenBox" Style="{StaticResource AppPasswordBoxStyle}" Height="38"/>
                                        <Button Content="Сохранить токен" Style="{StaticResource SecondaryButtonStyle}" Margin="0,9,0,0" Height="40" Padding="10,5" Click="SaveYandexToken_Click"/>
                                        <TextBlock Foreground="#898A95" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0">
                                            <Hyperlink NavigateUri="https://ym.marshal.dev/token/#implicit-oauth" RequestNavigate="TokenLink_RequestNavigate" Foreground="{DynamicResource AccentBrush}">Открыть страницу получения токена</Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="1" Padding="14,13" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Поверх всех окон" Foreground="#F0F0F3" FontSize="13"/>
                                            <TextBlock Text="Оставляет Qlyptra поверх других приложений" Foreground="#90919B" FontSize="11.5" Margin="0,5,12,0"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="TopmostToggle" Grid.Column="1" Style="{StaticResource IosToggleStyle}" VerticalAlignment="Center" Checked="TopmostToggle_Changed" Unchecked="TopmostToggle_Changed"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="1" Padding="14,13" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Запуск вместе с Windows" Foreground="#F0F0F3" FontSize="13"/>
                                            <TextBlock Text="Приложение запускается свёрнутым в системный трей" Foreground="#90919B" FontSize="11.5" Margin="0,5,12,0"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource IosToggleStyle}" VerticalAlignment="Center" Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="1" Padding="14,13" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Глобальная горячая клавиша" Foreground="#F0F0F3" FontSize="13"/>
                                        <TextBlock Text="Нажмите поле и задайте сочетание клавиш" Foreground="#90919B" FontSize="11.5" Margin="0,5,0,9"/>
                                        <TextBox x:Name="HotkeyTextBox" Style="{StaticResource DarkTextBoxStyle}" Height="38" IsReadOnly="True" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" GotKeyboardFocus="HotkeyTextBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyTextBox_LostKeyboardFocus"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="1" Padding="14,13">
                                    <StackPanel>
                                        <TextBlock Text="Удаление временного MP3" Foreground="#F0F0F3" FontSize="13"/>
                                        <TextBlock Text="После Ctrl+V временная копия будет удалена с выбранной задержкой. Если вставка не выполнена, файл автоматически очищается через 30 секунд." Foreground="#90919B" FontSize="11.5" TextWrapping="Wrap" Margin="0,5,0,9"/>
                                        <ComboBox x:Name="DeleteDelayCombo" Style="{StaticResource AppComboBoxStyle}" Height="36" SelectedValuePath="Tag" SelectionChanged="DeleteDelayCombo_Changed" DropDownOpened="DeleteDelayCombo_DropDownOpened" DropDownClosed="DeleteDelayCombo_DropDownClosed">
                                            <ComboBoxItem Style="{StaticResource AppComboBoxItemStyle}" Content="30 секунд" Tag="30"/>
                                            <ComboBoxItem Style="{StaticResource AppComboBoxItemStyle}" Content="45 секунд" Tag="45"/>
                                            <ComboBoxItem Style="{StaticResource AppComboBoxItemStyle}" Content="75 секунд (рекомендуется)" Tag="75"/>
                                            <ComboBoxItem Style="{StaticResource AppComboBoxItemStyle}" Content="120 секунд" Tag="120"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock Grid.Row="2" Text="Горячая клавиша может быть занята другой программой. В этом случае выберите другое сочетание." Foreground="#858691" FontSize="11.5" TextWrapping="Wrap" Margin="1,13,0,0"/>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="TrackReadyOverlay" Grid.Row="1" Panel.ZIndex="100" Background="#B9000000" Visibility="Collapsed" Opacity="0">
                <Border x:Name="ReadyCard" Width="460" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Margin="16,12,8,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Трек готов" Foreground="#F3F3F6" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button x:Name="ReadyCloseButton" Grid.Column="1" Style="{StaticResource CaptionPopupButtonStyle}"
                                    Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0" Click="ReadyClose_Click" ToolTip="Закрыть" Cursor="Hand"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                <Path Width="10" Height="10" Stretch="Fill"
                                      Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.7" StrokeStartLineCap="Square" StrokeEndLineCap="Square"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" Margin="18,0,18,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" Background="{DynamicResource CoverBrush}" ClipToBounds="True">
                                <Image x:Name="ReadyCoverImage" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ReadyTitleText" Text="Название трека" Foreground="#F3F3F6" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ReadyArtistText" Text="Исполнитель" Foreground="#A6A7B0" FontSize="11.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="MP3 высокого качества · с тегами" Foreground="#777984" FontSize="10.5" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="2" Background="{DynamicResource CoverBrush}" Padding="12,10" Margin="18,0,18,14">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3"/></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PopupTimerLabel" Text="Временный файл будет очищен" Foreground="#A6A7B0" FontSize="11.5"/>
                                    <TextBlock x:Name="PopupTimerText" Grid.Column="1" Text="30 сек" Foreground="#F3F3F6" FontSize="11.5" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid x:Name="PopupTimerTrack" Grid.Row="1" Background="{DynamicResource BorderBrushCustom}" ClipToBounds="True">
                                    <Border x:Name="PopupTimerFill" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Width="100"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="3" Margin="18,0,18,18">
                            <TextBlock x:Name="ReadySaveStatus" Text="" Foreground="#8BCF8F" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="ReadyCopyAudioButton" Content="Копировать MP3" Style="{StaticResource ActionButtonStyle}" Height="44" FontSize="13" Click="ReadyCopyAudio_Click"/>
                                <Button x:Name="ReadySaveButton" Grid.Column="2" Content="Сохранить" Style="{StaticResource SecondaryButtonStyle}" Height="44" FontSize="13" Click="ReadySave_Click"/>
                            </Grid>
                            <Button x:Name="ReadyCopyLinkButton" Content="Копировать ссылку" Style="{StaticResource SecondaryButtonStyle}" Height="42" FontSize="13" HorizontalAlignment="Stretch" Click="ReadyCopyLink_Click" Margin="0,0,0,8"/>
                            <Button x:Name="ReadyOpenFolderButton" Content="Открыть папку" Style="{StaticResource SecondaryButtonStyle}" Height="40" FontSize="12.5" HorizontalAlignment="Stretch" Click="ReadyOpenFolder_Click" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
